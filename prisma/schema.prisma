generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RolePermissionStatus {
  ACTIVE
  REVOKED
}

enum UserRoleAssignmentStatus {
  ACTIVE
  REVOKED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  cognitoSubject    String     @unique @map("cognito_subject")
  status            UserStatus
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  activatedAt       DateTime?  @map("activated_at")
  deactivatedAt     DateTime?  @map("deactivated_at")
  suspendedAt       DateTime?  @map("suspended_at")
  statusChangedAt   DateTime   @map("status_changed_at")
  statusChangedBy   String     @map("status_changed_by")
  statusChangeReason String    @map("status_change_reason")

  roleAssignments UserRoleAssignment[]

  @@index([status])
  @@map("users")
}

model Student {
  id                 String       @id @default(uuid()) @db.Uuid
  studentNumber      String       @unique @map("student_number")
  firstName          String       @map("first_name")
  lastName           String       @map("last_name")
  email              String
  phone              String?
  nationalId         String?      @map("national_id")
  addressLine1       String?      @map("address_line_1")
  addressLine2       String?      @map("address_line_2")
  city               String?
  country            String?
  emergencyContactName String?     @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  status             StudentStatus
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  statusChangedAt    DateTime     @map("status_changed_at")
  statusChangedBy    String       @map("status_changed_by")
  statusHistory      Json         @map("status_history")

  @@index([status])
  @@index([email])
  @@map("students")
}

model Role {
  id                 String     @id @default(uuid()) @db.Uuid
  key                String     @unique
  name               String
  description        String?
  status             RoleStatus
  rank               Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  createdBy          String     @map("created_by")
  updatedBy          String     @map("updated_by")
  deactivatedAt      DateTime?  @map("deactivated_at")
  deactivatedBy      String?    @map("deactivated_by")
  deactivationReason String?    @map("deactivation_reason")
  changeReference    String?    @map("change_reference")

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([status])
  @@map("roles")
}

model PermissionReference {
  id          String           @id
  rolePermissions RolePermission[]

  @@map("permission_references")
}

model BootstrapControl {
  id              String    @id @default("singleton") @db.VarChar(32)
  consumedAt      DateTime? @map("consumed_at")
  consumedBy      String?   @map("consumed_by")
  changeReference String?   @map("change_reference")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("iam_bootstrap_control")
}

model RolePermission {
  id                 String               @id @default(uuid()) @db.Uuid
  roleId             String               @map("role_id") @db.Uuid
  permissionId       String               @map("permission_id")
  status             RolePermissionStatus
  assignedAt         DateTime             @map("assigned_at")
  assignedBy         String               @map("assigned_by")
  assignmentReason   String               @map("assignment_reason")
  revokedAt          DateTime?            @map("revoked_at")
  revokedBy          String?              @map("revoked_by")
  revocationReason   String?              @map("revocation_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  changeReference    String?              @map("change_reference")

  role       Role               @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission PermissionReference @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([roleId, status])
  @@index([permissionId, status])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @map("user_id") @db.Uuid
  roleId             String                    @map("role_id") @db.Uuid
  status             UserRoleAssignmentStatus
  assignedAt         DateTime                  @map("assigned_at")
  assignedBy         String                    @map("assigned_by")
  revokedAt          DateTime?                 @map("revoked_at")
  revokedBy          String?                   @map("revoked_by")
  assignmentReason   String                    @map("assignment_reason")
  revocationReason   String?                   @map("revocation_reason")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  changeReference    String?                   @map("change_reference")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status])
  @@index([roleId, status])
  @@index([assignedBy, assignedAt])
  @@index([userId, assignedAt])
  @@index([roleId, assignedAt])
  @@map("user_role_assignments")
}

model AuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  eventName       String   @map("event_name")
  category        String
  actorId         String?  @map("actor_id")
  actorType       String   @map("actor_type")
  targetType      String   @map("target_type")
  targetId        String?  @map("target_id")
  action          String
  outcome         String
  occurredAt      DateTime @map("occurred_at")
  recordedAt      DateTime @default(now()) @map("recorded_at")
  correlationId   String?  @map("correlation_id")
  owningModule    String   @map("owning_module")
  sourceBoundary  String   @map("source_boundary")
  reason          String?
  changeReference String?  @map("change_reference")
  beforeState     Json?    @map("before_state")
  afterState      Json?    @map("after_state")

  @@index([eventName, occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}
