# Generic, non-secret application configuration.
APP_NAME=gisi
APP_VERSION=0.1.0
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
AUTH_PROVIDER=cognito

# Local-only placeholder. Do not use this file as a production or staging
# secret source. Put real local values in .env.local or a protected shell
# environment. "change-me" is intentionally not a usable credential.
DATABASE_URL=postgresql://gisi:change-me@localhost:5432/gisi_development

# Cognito infrastructure identifiers. These are not authentication secrets,
# but they are environment-specific operational values.
AWS_REGION=eu-west-1
AWS_USER_POOL_ID=replace-with-user-pool-id
AWS_CLIENT_ID=replace-with-client-id

# Staging and production must receive values from deployment configuration
# and managed secret/configuration services, not .env.local.
